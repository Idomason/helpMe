NODE_ENV=development
PORT=8000
PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
JWT_SECRET=
JWT_TOKEN_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
