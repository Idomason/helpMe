MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_COLLECTION_FEE_PERCENT=0
MONNIFY_COLLECTION_FEE_FLAT=0
MONNIFY_WITHDRAWAL_FEE=0
